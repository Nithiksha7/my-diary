# ====================================================================
# MY DIARY FRONTEND — PRODUCTION & DEVELOPMENT ENVIRONMENT VARIABLES
# ====================================================================

# 1. Base URL of the deployed Express Backend API
# For local development with Vite dev server proxy: leave empty or /api
# For production (e.g. Render / Railway / custom VPS): https://api.yourdomain.com/api or https://my-diary-backend.onrender.com/api
VITE_API_URL=https://api.yourdomain.com/api

# 2. Public Frontend Web Application Base URL (Used for generating letter links)
# For local development: http://localhost:5173
# For production (e.g. Vercel): https://my-diary-nine-tau.vercel.app
VITE_PUBLIC_APP_URL=https://my-diary-nine-tau.vercel.app
