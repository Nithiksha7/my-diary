# ====================================================================
# MY DIARY BACKEND — PRODUCTION & DEVELOPMENT ENVIRONMENT VARIABLES
# ====================================================================

# 1. Server Port & Environment
PORT=5000
NODE_ENV=production

# 2. MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/my_diary?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/my_diary?retryWrites=true&w=majority

# 3. Public Web Application Base URL (Used for generating recipient letter links in notification emails)
# Production: https://my-diary-nine-tau.vercel.app
# Local development: http://localhost:5173
APP_PUBLIC_URL=https://my-diary-nine-tau.vercel.app

# 4. Frontend Origin for CORS security validation (Comma-separated for multiple domains)
# Example: https://my-diary-nine-tau.vercel.app,http://localhost:5173
FRONTEND_URL=https://my-diary-nine-tau.vercel.app

# 5. JWT Authentication Secret Key (Cryptographically random 32+ character string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

