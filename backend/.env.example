# ====================================================================
# MY DIARY BACKEND — PRODUCTION & DEVELOPMENT ENVIRONMENT VARIABLES
# ====================================================================

# 1. Server Port & Environment
PORT=5000
NODE_ENV=production

# 2. MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/my_diary?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/my_diary?retryWrites=true&w=majority

# 3. Public Web Application Base URL (Used for generating recipient letter links in notification emails)
# Example: https://yourdomain.com or https://my-diary.vercel.app
APP_PUBLIC_URL=https://yourdomain.com

# 4. Frontend Origin for CORS security validation (Comma-separated for multiple domains)
# Example: https://yourdomain.com,https://my-diary.vercel.app
FRONTEND_URL=https://yourdomain.com

# 5. JWT Authentication Secret Key (Cryptographically random 32+ character string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# 6. Resend API Key for Transactional Email Delivery (Letters to Recipient)
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdef

# 7. Sender Email for Letter Delivery Notifications
# For Resend Sandbox testing: onboarding@resend.dev
# For Verified Domain: letters@yourdomain.com or "My Diary <letters@yourdomain.com>"
EMAIL_FROM="My Diary <onboarding@resend.dev>"
